# =============================================
# URL Shortener — Environment Variables
# =============================================
# Copy this file to .env and fill in production values.
# NEVER commit .env to version control.
# =============================================

# --- Database ---
DB_NAME=url_shortener
DB_USER=postgres
DB_PASS=CHANGE_ME_STRONG_PASSWORD

# --- Redis ---
# Leave empty for no password (dev only); set for production
REDIS_PASSWORD=

# --- JWT Security ---
# Base64-encoded secret key (minimum 256 bits / 32 bytes)
# Generate one with: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_32

# --- CORS ---
# Comma-separated list of allowed frontend origins
# Example: https://url-shortener.vercel.app,https://yourdomain.com
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app

# --- Server ---
# Port the backend is exposed on (default 8080)
APP_PORT=8080
